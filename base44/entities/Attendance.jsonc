{
  "name": "Attendance",
  "type": "object",
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "teacher_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "student_name": {
      "type": "string",
      "description": "Student name"
    },
    "admission_number": {
      "type": "string"
    },
    "grade": {
      "type": "string",
      "enum": [
        "Grade 7",
        "Grade 8",
        "Grade 9"
      ]
    },
    "class_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Attendance date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Present",
        "Absent",
        "Late"
      ],
      "default": "Present"
    },
    "term": {
      "type": "string",
      "enum": [
        "Term 1",
        "Term 2",
        "Term 3"
      ]
    },
    "teacher_email": {
      "type": "string"
    }
  },
  "required": [
    "student_name",
    "grade",
    "date",
    "status",
    "teacher_email"
  ]
}