{
  "name": "AuditLog",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "actor_email": {
      "type": "string",
      "description": "Administrator who performed the action"
    },
    "actor_name": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "e.g. school_registered, school_merged, school_deleted, user_linked"
    },
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "target": {
      "type": "string",
      "description": "Email or record the action was applied to"
    },
    "details": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "action"
  ]
}