{
  "name": "School",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.user_type": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "School name"
    },
    "code": {
      "type": "string",
      "description": "Unique school code"
    },
    "county": {
      "type": "string"
    },
    "sub_county": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "School email address"
    },
    "headteacher_name": {
      "type": "string"
    },
    "headteacher_email": {
      "type": "string"
    },
    "contact_number": {
      "type": "string"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended",
        "expired",
        "archived"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray",
        "gray"
      ],
      "default": "pending"
    },
    "date_registered": {
      "type": "string",
      "format": "date"
    },
    "school_id": {
      "type": "string",
      "description": "Canonical school identifier used by every school record"
    },
    "merged_into": {
      "type": "string",
      "description": "For merged duplicates: the school id that absorbed this record"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "archive_reason": {
      "type": "string",
      "description": "Why the school record was archived or removed"
    },
    "status_before_archive": {
      "type": "string",
      "description": "Status to restore when a school is un-archived"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "code"
  ]
}