{
  "name": "Student",
  "type": "object",
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "teacher_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "teacher_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "teacher_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "name": {
      "type": "string",
      "description": "Student full name"
    },
    "admission_number": {
      "type": "string",
      "description": "Student admission number"
    },
    "grade": {
      "type": "string",
      "enum": [
        "Grade 1",
        "Grade 2",
        "Grade 3",
        "Grade 4",
        "Grade 5",
        "Grade 6",
        "Grade 7",
        "Grade 8",
        "Grade 9"
      ],
      "description": "Student grade"
    },
    "class_name": {
      "type": "string",
      "description": "Class section"
    },
    "term": {
      "type": "string",
      "enum": [
        "Term 1",
        "Term 2",
        "Term 3"
      ],
      "description": "Academic term"
    },
    "exam_type": {
      "type": "string",
      "enum": [
        "Mid Term",
        "End Term"
      ],
      "description": "Type of exam"
    },
    "mathematics": {
      "type": "number"
    },
    "mathematics_band": {
      "type": "string",
      "enum": [
        "EE",
        "ME",
        "AE",
        "BE"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red"
      ]
    },
    "english": {
      "type": "number",
      "description": "English total"
    },
    "english_band": {
      "type": "string",
      "enum": [
        "EE",
        "ME",
        "AE",
        "BE"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red"
      ]
    },
    "english_p1": {
      "type": "number",
      "description": "English Paper 1 (out of 50)"
    },
    "english_p2": {
      "type": "number",
      "description": "English Paper 2 (out of 50)"
    },
    "kiswahili": {
      "type": "number",
      "description": "Kiswahili total"
    },
    "kiswahili_band": {
      "type": "string",
      "enum": [
        "EE",
        "ME",
        "AE",
        "BE"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red"
      ]
    },
    "kiswahili_p1": {
      "type": "number",
      "description": "Kiswahili Paper 1 (out of 50)"
    },
    "kiswahili_p2": {
      "type": "number",
      "description": "Kiswahili Paper 2 (out of 50)"
    },
    "integrated_science": {
      "type": "number",
      "description": "Integrated Science total"
    },
    "integrated_science_band": {
      "type": "string",
      "enum": [
        "EE",
        "ME",
        "AE",
        "BE"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red"
      ]
    },
    "integrated_science_p1": {
      "type": "number",
      "description": "Integrated Science Paper 1 (out of 70)"
    },
    "integrated_science_p2": {
      "type": "number",
      "description": "Integrated Science Paper 2 (out of 30)"
    },
    "agriculture": {
      "type": "number"
    },
    "agriculture_band": {
      "type": "string",
      "enum": [
        "EE",
        "ME",
        "AE",
        "BE"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red"
      ]
    },
    "social_studies": {
