      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red"
      ]
    },
    "subjects_config": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ordered list of subject keys used for this student's grade"
    },
    "overall_band": {
      "type": "string",
      "enum": [
        "EE",
        "ME",
        "AE",
        "BE"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red"
      ],
      "description": "Overall performance band"
    },
    "teacher_email": {
      "type": "string",
