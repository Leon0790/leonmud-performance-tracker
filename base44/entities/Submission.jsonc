{
  "name": "Submission",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.user_type": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "teacher"
              }
            },
            {
              "user_condition": {
                "data.user_type": "headteacher"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "headteacher"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "headteacher"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  },
  "properties": {
    "school_id": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "class_name": {
      "type": "string"
    },
    "term": {
      "type": "string"
    },
    "exam_type": {
      "type": "string"
    },
    "learners_count": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "approved",
        "needs_changes"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "submitted"
    },
    "headteacher_comment": {
      "type": "string"
    },
    "reviewed_by": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "school_id",
    "teacher_email",
    "grade",
    "term",
    "exam_type"
  ]
}