{
  "name": "SchoolClass",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.user_type": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "headteacher"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "headteacher"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "headteacher"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  },
  "properties": {
    "school_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Class name, e.g. Grade 7 East"
    },
    "grade": {
      "type": "string"
    },
    "stream": {
      "type": "string"
    },
    "class_teacher_email": {
      "type": "string"
    },
    "learning_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learner_count": {
      "type": "number"
    }
  },
  "required": [
    "school_id",
    "name",
    "grade"
  ]
}