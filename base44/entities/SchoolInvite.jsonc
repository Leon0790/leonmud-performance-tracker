{
  "name": "SchoolInvite",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "data.user_type": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "headteacher"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "headteacher"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "headteacher"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  },
  "properties": {
    "school_id": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string",
      "description": "Name of the invited teacher or headteacher"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "headteacher",
        "teacher"
      ],
      "enumColors": [
        "purple",
        "blue"
      ],
      "default": "teacher"
    },
    "grades": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "claimed",
        "declined",
        "expired",
        "cancelled"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red",
        "gray",
        "gray"
      ],
      "default": "pending"
    },
    "invited_by_email": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Invitation stops being valid after this date"
    },
    "email_sent": {
      "type": "boolean",
      "default": false
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "school_id",
    "email"
  ]
}