{
  "name": "PlatformLicence",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.user_type": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "properties": {
    "school_id": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "monthly",
        "annual",
        "legacy"
      ]
    },
    "amount": {
      "type": "number"
    },
    "payment_id": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date-time"
    },
    "period_end": {
      "type": "string",
      "format": "date-time"
    },
    "purchased_by_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired"
      ],
      "enumColors": [
        "green",
        "gray"
      ],
      "default": "active"
    }
  },
  "required": [
    "teacher_email",
    "plan",
    "period_end"
  ]
}