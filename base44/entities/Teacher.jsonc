{
  "name": "Teacher",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Teacher's full name"
    },
    "class_grade": {
      "type": "string",
      "enum": [
        "Grade 1",
        "Grade 2",
        "Grade 3",
        "Grade 4",
        "Grade 5",
        "Grade 6",
        "Grade 7",
        "Grade 8",
        "Grade 9"
      ],
      "description": "Class grade the teacher manages"
    },
    "class_name": {
      "type": "string",
      "description": "Class name or section"
    },
    "email": {
      "type": "string",
      "description": "Teacher's email address for welcome message"
    },
    "welcome_sent": {
      "type": "boolean",
      "description": "Whether a welcome message has been sent to this teacher",
      "default": false
    },
    "grade_subjects": {
      "type": "object",
      "description": "JSON map of grade -> array of subject keys selected by teacher"
    }
  },
  "required": [
    "full_name"
  ]
}