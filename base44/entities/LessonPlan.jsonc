{
  "name": "LessonPlan",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "data.user_type": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.school_id": "{{user.data.school_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.teacher_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "properties": {
    "school_id": {
      "type": "string"
    },
    "plan_version": {
      "type": "string",
      "enum": [
        "v1",
        "v2"
      ],
      "default": "v1",
      "description": "v1 = standard CBE format, v2 = Big Idea / Grapple format"
    },
    "title": {
      "type": "string",
      "description": "Lesson plan title"
    },
    "grade": {
      "type": "string",
      "enum": [
        "Grade 1",
        "Grade 2",
        "Grade 3",
        "Grade 4",
        "Grade 5",
        "Grade 6",
        "Grade 7",
        "Grade 8",
        "Grade 9"
      ]
    },
    "subject": {
      "type": "string",
      "description": "Learning area / subject"
    },
    "term": {
      "type": "string",
      "enum": [
        "Term 1",
        "Term 2",
        "Term 3"
      ]
    },
    "week": {
      "type": "number",
      "description": "Week number"
    },
    "lesson": {
      "type": "number",
      "description": "Lesson number within the week"
    },
    "duration": {
      "type": "number",
      "default": 40,
      "description": "Lesson duration in minutes"
    },
    "school_name": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string",
      "description": "Name of the teacher"
    },
    "teacher_email": {
      "type": "string"
    },
    "strand": {
      "type": "string",
      "description": "Strand e.g. Measurement; Length"
    },
    "sub_strand": {
      "type": "string"
    },
    "specific_outcomes": {
      "type": "string",
      "description": "Specific learning outcomes (lettered list)"
    },
    "core_competency": {
      "type": "string",
      "description": "Core competencies addressed in the lesson"
    },
    "key_inquiry_question": {
      "type": "string"
    },
    "learning_resources": {
      "type": "string"
    },
    "organization_of_learning": {
      "type": "string"
    },
    "introduction": {
      "type": "string",
      "description": "Introduction content"
    },
    "lesson_development": {
      "type": "string",
      "description": "Lesson development with Step 1, Step 2, Step 3"
    },
    "extended_activities": {
      "type": "string",
      "description": "Extended / homework activities"
    },
    "conclusion": {
      "type": "string",
      "description": "Conclusion / closing question"
    },
    "reflection": {
      "type": "string",
      "description": "Teacher reflection notes"
    },
    "big_idea": {
      "type": "string",
      "description": "V2: Big Idea / overarching theme"
    },
    "mission_vision": {
      "type": "string",
      "description": "V2: Mission/Vision statement"
    },
    "lesson_target": {
      "type": "string",
      "description": "V2: I can... lesson target statement"
    },
    "v2_introduction": {
      "type": "string",
      "description": "V2: Introduction step content"
    },
    "v2_grapple": {
      "type": "string",
      "description": "V2: Grapple step content"
    },
    "v2_mini_lesson": {
      "type": "string",
      "description": "V2: Mini-Lesson step content"
    },
    "v2_guided_practice": {
      "type": "string",
      "description": "V2: Guided Practice step content"
    },
    "v2_work_time": {
      "type": "string",
      "description": "V2: Work-Time step content"
    },
    "v2_debrief": {
      "type": "string",
      "description": "V2: Debrief step content"
    },
    "subscription_type": {
      "type": "string",
      "enum": [
        "monthly",
        "term"
      ],
      "description": "Which plan was used to generate this"
    }
  },
  "required": [
    "grade",
    "subject",
    "term",
    "week",
    "lesson"
  ]
}